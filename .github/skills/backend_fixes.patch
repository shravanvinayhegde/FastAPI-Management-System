+def _hydrate_posts(db: Session, results: list) -> list[dict]:
+    """Attach `owner` and `media` to a list of (Post, votes) tuples with exactly one
+    extra query each, instead of the lazy-loaded relationship firing a fresh SELECT per
+    post (an N+1 query pattern that scales linearly with page size)."""
+    posts = [post for post, _ in results]
+    if posts:
+        loaded = db.query(models.Post).filter(
+            models.Post.id.in_([p.id for p in posts]),
+        ).options(joinedload(models.Post.owner), selectinload(models.Post.media)).all()
+        by_id = {p.id: p for p in loaded}
+        results = [(by_id[post.id], votes) for post, votes in results]
+    return [{"Post": post, "votes": votes} for post, votes in results]
