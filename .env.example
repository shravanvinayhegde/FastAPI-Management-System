
# DATABASE_URL=postgresql://user:password@host:5432/dbname

## Option B (local/dev split fields):
database_hostname=localhost
database_port=5432
database_username=*********
database_password=******
database_name=*******

secret_key=CHANGE_ME
algorithm=HS256
access_token_expire_minutes=60

# "*" or comma-separated list like:
# cors_origins=http://localhost:3000,https://myapp.com
cors_origins=*

# Persistent local directory or a mounted production volume for uploaded media.
media_directory=media
max_image_upload_mb=10
max_video_upload_mb=100
max_image_dimension=4096
# Optional canonical frontend URL used in post share responses.
# frontend_url=https://your-frontend.example.com
