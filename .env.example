
# DATABASE_URL=postgresql://user:password@host:5432/dbname

## Option B (local/dev split fields):
database_hostname=localhost
database_port=5432
database_username=*********
database_password=******
database_name=*******

secret_key=CHANGE_ME
algorithm=HS256
access_token_expire_minutes=60

# "*" or comma-separated list like:
# cors_origins=http://localhost:3000,https://myapp.com
cors_origins=*

# Local media fallback when S3/R2 is not configured (dev). On Render free tier, set S3/R2 below.
media_directory=media
# Neon Object Storage (what the Render deployment uses). All five are required:
#   S3_ENDPOINT_URL        = branch storage endpoint, e.g. https://br-xxxx.storage.c-2.us-east-2.aws.neon.tech
#   S3_REGION              = us-east-2 (the region of your Neon project)
#   S3_BUCKET              = bucket name created in Neon Console -> Object storage
#   S3_ACCESS_KEY_ID       = credential "token_id" (starts with nak_live_, not token_id_short)
#   S3_SECRET_ACCESS_KEY   = credential "s3_secret_access_key" (not the api_token)
# The credential needs both storage:read and storage:write scopes, issued on the same branch as the endpoint.
# Optional: if the bucket is public, set S3_PUBLIC_BASE_URL=<S3_ENDPOINT_URL>/<S3_BUCKET>
# Leave it unset for a private bucket (signed links are used).
# After deploying, log in and open /docs -> GET /health/storage to test the whole chain.
#
# Object storage (recommended for production — survives redeploys/spin-down):
# s3_bucket=your-bucket
# s3_region=auto
# s3_endpoint_url=https://<account_id>.r2.cloudflarestorage.com
# s3_public_base_url=https://pub-xxx.r2.dev
# s3_access_key_id=
# s3_secret_access_key=
max_image_upload_mb=10
max_video_upload_mb=100
max_image_dimension=4096
# Optional canonical frontend URL used in post share responses.
# frontend_url=https://your-frontend.example.com
